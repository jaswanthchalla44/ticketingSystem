# Public values only. Never put secrets in VITE_* variables: they are shipped to the browser.

# local (default): dev sign-in against the local API (X-Dev-User header)
# cognito: sign in with the Cognito user pool (Terraform outputs)
VITE_AUTH_MODE=local

# Base URL for API calls. Empty means same origin (/api), which is what CloudFront and the Vite proxy use.
VITE_API_URL=

# Cognito mode only (public identifiers, not secrets)
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=
