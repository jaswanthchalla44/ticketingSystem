{
  "name": "helpdesk-pro-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "VITE_AUTH_MODE=local vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
